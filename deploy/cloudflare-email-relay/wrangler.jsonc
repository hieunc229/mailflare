{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mailflare-email-relay",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-20",
	// Set with `wrangler secret put`: MAILFLARE_URL (https://mail.example.com) and
	// INBOUND_WEBHOOK_SECRET (same value as on the self-hosted server).
	"observability": { "enabled": true }
}
