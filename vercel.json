{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "nextjs",
	"installCommand": "npm ci",
	"buildCommand": "npm run build:vercel",
	"crons": [
		{ "path": "/api/internal/cron/frequent", "schedule": "0 3 * * *" },
		{ "path": "/api/internal/cron/daily", "schedule": "0 2 * * *" }
	]
}
